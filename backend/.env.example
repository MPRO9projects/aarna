NODE_ENV=production
PORT=5010
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password-here
ADMIN_SESSION_SECRET=your-long-random-secret-here
ADMIN_TOKEN_TTL_MS=28800000
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://your-domain.com
CONTACTS_DATA_FILE=./private-data/contacts.json
ANALYTICS_DATA_FILE=./private-data/analytics.json
ENABLE_HSTS=false
UPLOADS_CACHE_MAX_AGE_SECONDS=31536000
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
ANALYTICS_RATE_LIMIT_WINDOW_MS=900000
ANALYTICS_RATE_LIMIT_MAX=300
